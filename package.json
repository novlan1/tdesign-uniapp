{
  "name": "tdesign-uniapp",
  "version": "0.1.1",
  "private": "true",
  "homepage": "https://novlan1.github.io/tdesign-uniapp/",
  "bugs": {
    "url": "https://github.com/novlan1/tdesign-uniapp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novlan1/tdesign-uniapp.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"pnpm --filter=\"./packages/demo\" dev:h5\" \"pnpm --filter=\"./packages/site\" dev\"",
    "dev:mp-weixin": "concurrently \"npm run watch\" \"pnpm --filter=\"./packages/demo\" dev:mp-weixin\"",
    "dev:mp": "npm run dev:mp-weixin",
    "dev:mp:pure": "pnpm --filter=\"./packages/demo\" dev:mp-weixin",
    "build": "pnpm --filter=\"./packages/site\" build && pnpm --filter=\"./packages/demo\" build:h5",
    "build:mp": "pnpm --filter=\"./packages/demo\" build:mp-weixin",
    "build:mp-weixin": "npm run build:mp",
    "type-check": "vue-tsc --noEmit",
    "init": "node packages/demo/script/watch/init.js && node packages/demo/script/pages/index.js",
    "watch": "node packages/demo/script/watch/watch.js",
    "prepare": "npm run init",
    "release:prepare": "node packages/demo/script/release/prepare.js",
    "publish": "cd npm_dist && npm publish"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.19",
    "@stylistic/eslint-plugin-jsx": "3.1.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.1",
    "eslint": "8.57.1",
    "eslint-config-light": "latest",
    "eslint-config-light-vue3": "latest",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-jest": "25",
    "eslint-plugin-light": "latest",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.26.1",
    "eslint-plugin-react-hooks": "4.2.0",
    "eslint-plugin-tailwindcss": "3.18.0",
    "eslint-plugin-vue": "9.14.0",
    "typescript": "5.1",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
