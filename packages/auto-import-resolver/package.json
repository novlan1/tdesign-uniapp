{
  "name": "tdesign-uniapp-auto-import-resolver",
  "version": "0.1.3",
  "description": "On-demand components auto importing for series of TDesign UniApp",
  "author": "novlan1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsx scripts/prebuild.ts && tsdown"
  },
  "dependencies": {
    "unplugin-utils": "^0.3.0",
    "unplugin-vue-components": "^29.0.0"
  },
  "devDependencies": {
    "tdesign-icons-vue-next": "latest",
    "tsdown": "^0.12.9",
    "tsx": "^4.19.2",
    "typescript": " ^5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novlan1/tdesign-uniapp.git",
    "directory": "packages/auto-import-resolver"
  },
  "files": [
    "dist"
  ]
}
